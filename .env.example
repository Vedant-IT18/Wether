# WeatherGPT Configuration (Smart India Hackathon 2026)

# Server Config
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Default Initial City
DEFAULT_CITY=Nagpur
DEFAULT_LAT=21.1458
DEFAULT_LON=79.0882

# Optional LLM API Keys (If left empty, WeatherGPT uses intelligent heuristic rule-based NLP fallback)
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Weather Data Provider (Open-Meteo is free & no key required)
WEATHER_PROVIDER=open-meteo
